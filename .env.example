# ─────────────────────────────────────────────────────────────
# Blueprint Advantage — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Used by the Stripe webhook to write
# subscription rows past RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ────────────────────────────────────────────────────
# Use test keys (sk_test_… / pk_test_…) until you go live.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# The recurring $50/mo Price ID (price_…), created in the Stripe dashboard.
STRIPE_PRICE_ID=price_xxx
# Webhook signing secret (whsec_…) from the Stripe CLI or dashboard endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── AI Study Buddy (optional) ─────────────────────────────────
# OpenAI-compatible. Works with OpenAI, DeepSeek, Groq, Together, etc.
# Without a key, the tutor runs in a friendly demo-coach fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # e.g. https://api.deepseek.com/v1
OPENAI_MODEL=gpt-4o-mini                     # e.g. deepseek-chat
